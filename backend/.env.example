# MongoDB Connection
# Local:
MONGO_URI=mongodb://localhost:27017/edureach
# MongoDB Atlas (for deployment on Render):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/edureach

# Server Port
PORT=5000

# Admin Password (simple password — no JWT needed for now)
ADMIN_PASSWORD=edureach@admin123
